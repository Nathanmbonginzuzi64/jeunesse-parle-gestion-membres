###############################################################################
# JEUNESSE PARLE 🇨🇩 — Backend Laravel
# Copiez ce fichier vers .env puis exécutez : php artisan key:generate
# N'inscrivez JAMAIS de secret réel dans ce fichier : il est versionné.
###############################################################################

APP_NAME="Jeunesse Parle"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Kinshasa

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#------------------------------------------------------------------------------
# Base de données
# SQLite par défaut (zéro configuration). Pour MySQL, décommentez le bloc.
#------------------------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=jeunesse_parle
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

#------------------------------------------------------------------------------
# Frontend & CORS
# CORS_ALLOWED_ORIGINS accepte une liste séparée par des virgules.
#------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

#------------------------------------------------------------------------------
# Organisation
#------------------------------------------------------------------------------
JP_ORG_NAME="Jeunesse Parle"
JP_ORG_COUNTRY="République Démocratique du Congo"
JP_ORG_LOGO_URL=
JP_SUPPORT_EMAIL=contact@jeunesseparle.cd

#------------------------------------------------------------------------------
# Adhésion et cartes de membre
#------------------------------------------------------------------------------
JP_MINIMUM_AGE=15
JP_MAXIMUM_AGE=40
JP_CARD_VALIDITY_YEARS=3
JP_CARD_TEMPLATE_VERSION=v1

# URL de base encodée dans les QR codes : elle doit pointer vers l'application
# web publique (et non vers l'API).
JP_VERIFICATION_BASE_URL=http://localhost:3000

#------------------------------------------------------------------------------
# Sécurité
#------------------------------------------------------------------------------
JP_MAX_LOGIN_ATTEMPTS=5
JP_LOCKOUT_MINUTES=15
JP_PHOTO_MAX_KB=10240
JP_EXPORT_MAX_ROWS=20000

# Mot de passe des comptes de démonstration (environnements locaux uniquement).
# Le seeder refuse de s'exécuter en production.
JP_DEMO_PASSWORD=

#------------------------------------------------------------------------------
# Biométrie WebAuthn (Windows Hello)
# rp_id = hostname du frontend (localhost si http://localhost:3000)
#------------------------------------------------------------------------------
JP_BIOMETRICS_ENABLED=true
JP_BIOMETRICS_PROVIDER=webauthn
JP_BIOMETRICS_LAB_MODE=true
JP_WEBAUTHN_RP_ID=localhost

#------------------------------------------------------------------------------
# Cartographie
# Laissez vide tant qu'aucun fournisseur n'est souscrit : la carte fonctionne
# en mode agrégé sans service externe.
#------------------------------------------------------------------------------
JP_MAP_PROVIDER=none
GOOGLE_MAPS_API_KEY=

#------------------------------------------------------------------------------
# Biométrie — désactivée par défaut.
# L'activation suppose un prestataire certifié et un cadre légal validé.
#------------------------------------------------------------------------------
JP_BIOMETRICS_ENABLED=true
JP_BIOMETRICS_PROVIDER=local-hash
JP_BIOMETRICS_LAB_MODE=true

JP_PHOTO_MAX_KB=10240
# Médias actualités (image / vidéo) — 100 Mo. Adapter aussi upload_max_filesize / post_max_size PHP.
JP_NEWS_MEDIA_MAX_KB=102400

#------------------------------------------------------------------------------
# Messagerie
#------------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@jeunesseparle.cd"
MAIL_FROM_NAME="${APP_NAME}"

#------------------------------------------------------------------------------
# SMS (à brancher lorsque le fournisseur sera choisi)
#------------------------------------------------------------------------------
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

#------------------------------------------------------------------------------
# Stockage objet (optionnel)
#------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
