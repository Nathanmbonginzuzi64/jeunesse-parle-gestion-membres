{
  "expo": {
    "name": "Jeunesse Parle",
    "slug": "jeunesse-parle-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jeunesseparle",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cd.jeunesseparle.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Scanner les QR codes des cartes membres Jeunesse Parle."
      }
    },
    "android": {
      "package": "cd.jeunesseparle.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0087D1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["CAMERA"],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Autoriser Jeunesse Parle à utiliser la caméra pour scanner les QR codes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.jpeg",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0087D1"
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://127.0.0.1:8000/api"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
